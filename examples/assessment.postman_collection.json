              "raw": "{\n  \"accountId\": \"ACC-BASIC\",\n  \"currency\": \"INR\",\n  \"openingBalance\": 0,\n  \"startingSequence\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
