    {
      "name": "03 Idempotency Testing",
      "item": [
        {
          "name": "Same request replay",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"TXN-BASIC\",\n  \"requestId\": \"REQ-BASIC\",\n  \"accountId\": \"ACC-BASIC\",\n  \"currency\": \"INR\",\n  \"sequenceNumber\": 1,\n  \"transactionType\": \"CREDIT\",\n  \"amount\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "New request duplicate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"TXN-BASIC\",\n  \"requestId\": \"REQ-BASIC-DUP\",\n  \"accountId\": \"ACC-BASIC\",\n  \"currency\": \"INR\",\n  \"sequenceNumber\": 1,\n  \"transactionType\": \"CREDIT\",\n  \"amount\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Duplicate outcome\", () => pm.expect(pm.response.json().outcome).to.eql(\"DUPLICATE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conflicting duplicate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
