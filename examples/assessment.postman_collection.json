{
  "info": {
    "name": "Transaction Processing Service \u2014 Assessment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against a fresh database with the demo profile. Use 1500 ms runner delay so the asynchronous worker can advance. Requests are ordered by folder. Read README for recovery and replay instructions."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 Account Management",
